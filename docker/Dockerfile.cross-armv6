# Raspberry Pi Zero / Zero W / Pi 1 (ARMv6, VFPv2, no NEON).
#
# Based on cross-rs's own image: its crosstool-ng toolchain and C runtime
# target ARMv6. Ubuntu's crossbuild-essential-armhf (used before 5.1.1)
# targets ARMv7 (Thumb-2, VFPv3, NEON), so every C object and the crt startup
# code in the "armv6" binary were ARMv7 and it crashed with SIGSEGV on the
# first such instruction. `readelf -A` still reports Tag_CPU_arch v7 for a
# good build (ring's ARMv7/NEON assembly, selected at runtime), so verify by
# starting the binary on a Pi Zero instead.
FROM ghcr.io/cross-rs/arm-unknown-linux-gnueabihf:0.2.5

# ALSA headers and link stub only: the binary uses the target's own
# libasound at runtime.
RUN dpkg --add-architecture armhf && \
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    pkg-config \
    libasound2-dev:armhf \
    && rm -rf /var/lib/apt/lists/*

ENV PKG_CONFIG_PATH=/usr/lib/arm-linux-gnueabihf/pkgconfig
ENV PKG_CONFIG_ALLOW_CROSS=1
